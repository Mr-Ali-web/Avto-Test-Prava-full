# Bu faylni ".env" nomi bilan nusxalang va to'ldiring. .env ni hech kimga yubormang va GitHub'ga yuklamang!

# 1) @BotFather dan olingan token (majburiy)
BOT_TOKEN=

# 2) Admin Telegram ID lari, vergul bilan (to'lovlarni tasdiqlash uchun). ID ni @userinfobot dan bilib oling
ADMIN_IDS=

# 3) Karta orqali to'lov (ixtiyoriy). Bo'sh qoldirsangiz, bu usul ko'rinmaydi
CARD_NUMBER=
CARD_OWNER=

# 4) Click/Payme: BotFather > /mybots > botingiz > Payments dan olingan token (ixtiyoriy)
PAYMENT_PROVIDER_TOKEN=
